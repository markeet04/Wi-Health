{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".read": "auth != null && auth.token.role === 'admin'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.role === 'admin')",
        "profile": {
          ".write": "auth != null && (auth.uid === $uid || auth.token.role === 'admin')"
        },
        "settings": {
          ".write": "auth != null && auth.uid === $uid"
        },
        "fcmTokens": {
          ".write": "auth != null && auth.uid === $uid"
        },
        "pairingCode": {
          ".write": "auth != null && (auth.token.role === 'admin' || auth.uid === $uid)"
        },
        "role": {
          ".write": "auth != null && (auth.token.role === 'admin' || (auth.uid === $uid && !data.exists() && newData.val() === 'app_user'))",
          ".validate": "newData.val() === 'app_user' || newData.val() === 'admin'"
        },
        "devices": {
          ".write": "auth != null && (auth.token.role === 'admin' || auth.uid === $uid)",
          "$deviceId": {
            ".validate": "auth.token.role === 'admin' || root.child('devices').child($deviceId).child('meta').child('ownerUid').val() === auth.uid"
          }
        }
      }
    },

    "devices": {
      ".read": "auth != null && auth.token.role === 'admin'",
      "$deviceId": {
        ".read": "auth != null && (auth.token.role === 'admin' || root.child('users').child(auth.uid).child('devices').child($deviceId).exists())",
        "meta": {
          ".write": "auth != null && (auth.token.role === 'admin' || ((!data.child('ownerUid').exists() || data.child('ownerUid').val() === '') && newData.child('ownerUid').val() === auth.uid) || (data.child('ownerUid').val() === auth.uid && newData.child('ownerUid').val() === ''))",
          "ownerUid": { ".validate": "auth.token.role === 'admin' || newData.val() === auth.uid || newData.val() === ''" },
          "normalLow": { ".validate": "newData.isNumber() && newData.val() > 0" },
          "normalHigh": { ".validate": "newData.isNumber() && newData.val() <= 60" }
        },
        "live": {
          ".write": "auth != null && (auth.uid === $deviceId && auth.token.device === true)",
          ".validate": "newData.hasChildren(['bpm', 'confidence', 'signalQuality', 'status', 'updatedAt'])",
          "bpm": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 60" },
          "confidence": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
          "signalQuality": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
          "status": { ".validate": "newData.val() === 'ok' || newData.val() === 'no_breathing' || newData.val() === 'low_signal' || newData.val() === 'calibrating'" },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        "sessions": {
          ".write": "auth != null && (auth.uid === $deviceId && auth.token.device === true)"
        },
        "history": {
          ".write": "auth != null && (auth.token.role === 'admin' || root.child('users').child(auth.uid).child('devices').child($deviceId).exists())",
          "$ts": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 60"
          }
        },
        "health": {
          ".write": "auth != null && (auth.uid === $deviceId && auth.token.device === true)"
        }
      }
    },

    "alerts": {
      "$deviceId": {
        ".read": "auth != null && (auth.token.role === 'admin' || root.child('users').child(auth.uid).child('devices').child($deviceId).exists())",
        "$alertId": {
          ".write": "auth != null && ((auth.uid === $deviceId && auth.token.device === true && !data.exists()) || auth.token.role === 'admin')",
          "acknowledged": {
            ".write": "auth != null && (auth.token.role === 'admin' || root.child('users').child(auth.uid).child('devices').child($deviceId).exists())",
            ".validate": "newData.isBoolean()"
          },
          "acknowledgedBy": {
            ".write": "auth != null && (auth.token.role === 'admin' || root.child('users').child(auth.uid).child('devices').child($deviceId).exists())",
            ".validate": "newData.val() === auth.uid"
          },
          "dismissed": {
            ".write": "auth != null && (auth.token.role === 'admin' || root.child('users').child(auth.uid).child('devices').child($deviceId).exists())",
            ".validate": "newData.isBoolean()"
          },
          "dismissedBy": {
            ".write": "auth != null && (auth.token.role === 'admin' || root.child('users').child(auth.uid).child('devices').child($deviceId).exists())",
            ".validate": "newData.val() === auth.uid"
          },
          "severity": { ".validate": "newData.val() === 'urgent' || newData.val() === 'warning' || newData.val() === 'info'" },
          "type": { ".validate": "newData.val() === 'apnea' || newData.val() === 'tachypnea' || newData.val() === 'bradypnea' || newData.val() === 'low_signal'" }
        }
      }
    },

    "settings": {
      ".read": "auth != null && auth.token.role === 'admin'",
      ".write": "auth != null && auth.token.role === 'admin'"
    },

    "complaints": {
      ".read": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'app_user')",
      ".indexOn": ["uid", "status"],
      "$complaintId": {
        ".read": "auth != null && (data.child('uid').val() === auth.uid || auth.token.role === 'admin')",
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid && auth.token.role !== 'admin') || auth.token.role === 'admin')",
        "status": {
          ".write": "auth != null && auth.token.role === 'admin'",
          ".validate": "newData.val() === 'open' || newData.val() === 'in_progress' || newData.val() === 'resolved'"
        },
        "messages": {
          ".read": "auth != null && (data.parent().child('uid').val() === auth.uid || auth.token.role === 'admin')",
          ".write": "auth != null && data.parent().child('status').val() !== 'resolved' && ((data.parent().child('uid').val() === auth.uid && auth.token.role !== 'admin') || auth.token.role === 'admin')",
          "$messageId": {
            ".write": "auth != null && !data.exists() && data.parent().parent().child('status').val() !== 'resolved' && ((auth.uid === data.parent().parent().child('uid').val() && auth.token.role !== 'admin') || auth.token.role === 'admin') && newData.child('senderUid').val() === auth.uid && newData.child('senderRole').val() === (auth.token.role === 'admin' ? 'admin' : 'app_user') && newData.hasChildren(['senderUid', 'senderRole', 'text', 'sentAt'])",
            ".validate": "newData.child('senderUid').val() === auth.uid && (newData.child('senderRole').val() === 'app_user' || newData.child('senderRole').val() === 'admin') && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('sentAt').isNumber()"
          }
        },
        "adminResponse": {
          ".write": "auth != null && auth.token.role === 'admin'"
        }
      }
    },

    "pairingCodes": {
      ".read": false,
      ".write": false
    },

    "deviceRequests": {
      ".read": "auth != null && auth.token.role === 'admin'",
      ".indexOn": ["uid", "status"],
      "$requestId": {
        ".read": "auth != null && (data.child('uid').val() === auth.uid || auth.token.role === 'admin')",
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid && auth.token.role !== 'admin') || auth.token.role === 'admin')",
        ".validate": "newData.hasChildren(['uid', 'patientName', 'status', 'createdAt'])",
        "uid": { ".validate": "newData.val() === auth.uid || auth.token.role === 'admin'" },
        "status": {
          ".write": "auth != null && auth.token.role === 'admin'",
          ".validate": "newData.val() === 'pending' || newData.val() === 'fulfilled' || newData.val() === 'declined'"
        },
        "fulfilledDeviceId": {
          ".write": "auth != null && auth.token.role === 'admin'"
        }
      }
    }
  }
}
